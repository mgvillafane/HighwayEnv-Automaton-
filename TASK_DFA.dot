digraph Tasks {
  rankdir=LR;
  node [shape=circle];
  start [shape=point];
  start -> cruise_none;
  cruise_none [shape=doublecircle, label="cruise\nnone"];
  cruise_none -> cruise_left [label="switch_lane_left"];
  cruise_none -> accelerate_none [label="accelerate"];
  cruise_none -> cruise_right [label="switch_lane_right"];
  cruise_none -> follow_car_none [label="follow_car"];
  cruise_none -> brake_none [label="brake"];
  cruise_none -> cruise_none [label="cruise, lane_complete, task_complete, reject, tick, reset"];
  cruise_none -> ended_none [label="end"];
  accelerate_none [shape=circle, label="accelerate\nnone"];
  accelerate_none -> cruise_left [label="switch_lane_left"];
  accelerate_none -> accelerate_none [label="accelerate, lane_complete, reject, tick"];
  accelerate_none -> cruise_right [label="switch_lane_right"];
  accelerate_none -> follow_car_none [label="follow_car"];
  accelerate_none -> brake_none [label="brake"];
  accelerate_none -> cruise_none [label="cruise, task_complete, reset"];
  accelerate_none -> ended_none [label="end"];
  follow_car_none [shape=circle, label="follow_car\nnone"];
  follow_car_none -> cruise_left [label="switch_lane_left"];
  follow_car_none -> accelerate_none [label="accelerate"];
  follow_car_none -> cruise_right [label="switch_lane_right"];
  follow_car_none -> follow_car_none [label="follow_car, lane_complete, reject, tick"];
  follow_car_none -> brake_none [label="brake"];
  follow_car_none -> cruise_none [label="cruise, task_complete, reset"];
  follow_car_none -> ended_none [label="end"];
  brake_none [shape=circle, label="brake\nnone"];
  brake_none -> cruise_left [label="switch_lane_left"];
  brake_none -> accelerate_none [label="accelerate"];
  brake_none -> cruise_right [label="switch_lane_right"];
  brake_none -> follow_car_none [label="follow_car"];
  brake_none -> brake_none [label="brake, lane_complete, reject, tick"];
  brake_none -> cruise_none [label="cruise, task_complete, reset"];
  brake_none -> ended_none [label="end"];
  cruise_left [shape=circle, label="cruise\nleft"];
  cruise_left -> cruise_left [label="switch_lane_left, switch_lane_right, follow_car, cruise, task_complete, reject, tick"];
  cruise_left -> accelerate_left [label="accelerate"];
  cruise_left -> brake_left [label="brake"];
  cruise_left -> cruise_none [label="lane_complete, reset"];
  cruise_left -> ended_none [label="end"];
  accelerate_left [shape=circle, label="accelerate\nleft"];
  accelerate_left -> accelerate_left [label="switch_lane_left, accelerate, switch_lane_right, follow_car, reject, tick"];
  accelerate_left -> brake_left [label="brake"];
  accelerate_left -> cruise_left [label="cruise, task_complete"];
  accelerate_left -> accelerate_none [label="lane_complete"];
  accelerate_left -> ended_none [label="end"];
  accelerate_left -> cruise_none [label="reset"];
  brake_left [shape=circle, label="brake\nleft"];
  brake_left -> brake_left [label="switch_lane_left, switch_lane_right, follow_car, brake, reject, tick"];
  brake_left -> accelerate_left [label="accelerate"];
  brake_left -> cruise_left [label="cruise, task_complete"];
  brake_left -> brake_none [label="lane_complete"];
  brake_left -> ended_none [label="end"];
  brake_left -> cruise_none [label="reset"];
  cruise_right [shape=circle, label="cruise\nright"];
  cruise_right -> cruise_right [label="switch_lane_left, switch_lane_right, follow_car, cruise, task_complete, reject, tick"];
  cruise_right -> accelerate_right [label="accelerate"];
  cruise_right -> brake_right [label="brake"];
  cruise_right -> cruise_none [label="lane_complete, reset"];
  cruise_right -> ended_none [label="end"];
  accelerate_right [shape=circle, label="accelerate\nright"];
  accelerate_right -> accelerate_right [label="switch_lane_left, accelerate, switch_lane_right, follow_car, reject, tick"];
  accelerate_right -> brake_right [label="brake"];
  accelerate_right -> cruise_right [label="cruise, task_complete"];
  accelerate_right -> accelerate_none [label="lane_complete"];
  accelerate_right -> ended_none [label="end"];
  accelerate_right -> cruise_none [label="reset"];
  brake_right [shape=circle, label="brake\nright"];
  brake_right -> brake_right [label="switch_lane_left, switch_lane_right, follow_car, brake, reject, tick"];
  brake_right -> accelerate_right [label="accelerate"];
  brake_right -> cruise_right [label="cruise, task_complete"];
  brake_right -> brake_none [label="lane_complete"];
  brake_right -> ended_none [label="end"];
  brake_right -> cruise_none [label="reset"];
  ended_none [shape=circle, label="ended\nnone"];
  ended_none -> ended_none [label="switch_lane_left, accelerate, switch_lane_right, follow_car, brake, cruise, lane_complete, task_complete, reject, tick, end"];
  ended_none -> cruise_none [label="reset"];
}
